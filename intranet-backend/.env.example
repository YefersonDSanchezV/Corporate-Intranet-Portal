# =============================================================================
# .env.example — Plantilla para entorno de PRODUCCION
# Copiar a .env y completar los secretos reales. No commitear .env
# =============================================================================

# Base de datos PostgreSQL
POSTGRES_HOST=192.168.3.121
POSTGRES_PORT=5432
POSTGRES_DB=intraicvc
POSTGRES_USER=sistemasicvc
POSTGRES_PASSWORD=CHANGEME

# Servidor
SERVER_PORT=8080
TZ=America/Bogota
SPRING_PROFILES_ACTIVE=prod

# JWT — generar un secreto Base64 de al menos 256 bits (32 bytes)
# Ejemplo: openssl rand -base64 64
JWT_SECRET=CHANGEME_GENERAR_SECRETO_BASE64_64_CHARS_MINIMO
JWT_EXPIRATION_MINUTES=480
JWT_ISSUER=intranet-icvc

# Seeder administrador inicial (se crea solo si no existe)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGEME
ADMIN_IDENTIFICACION=0
ADMIN_NOMBRE_COMPLETO=Administrador
ADMIN_CORREO=admin@icvc.com.co
ADMIN_CARGO_NOMBRE=Administrador
